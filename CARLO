-- SELECCIÓN FILTRADA CENTRADA DE NUEVO
local function getClosest()
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    local closest, best = nil, math.huge
    local center = camera.ViewportSize / 2
    
    for _, o in ipairs(Players:GetPlayers()) do
        if o ~= localPlayer and o.Character then
            local targetChar = o.Character
            local headPart = targetChar:FindFirstChild("Head")
            local hum = targetChar:FindFirstChildOfClass("Humanoid")
            local hrp = targetChar:FindFirstChild("HumanoidRootPart")
            
            if headPart and hum and hrp and hrp.Position.Y > -40 and hum.Health > 0 then
                local sPos, on = camera:WorldToViewportPoint(headPart.Position)
                if on then
                    local d = (Vector2.new(sPos.X, sPos.Y) - center).Magnitude
                    if d <= FOV and d < best then
                        best, closest = d, headPart
                    end
                end
            end
        end
    end
    return closest
end

-- MULTIPLICADOR DE ENTRADA EFECTIVO ORIGINAL (0.40)
local Smoothness = 0.40

-- BUCLE CENTRAL ESTABILIZADO ANTI-CRASH PARA EL MOTOR DE APUNTADO
RunService.RenderStepped:Connect(function()
    if not camera or not gui.Parent then return end
    
    -- El Aimbot preciso recuperado trabajando sobre deltas seguros
    if aEn then
        local t = getClosest()
        if t then
            local sPos, on = camera:WorldToViewportPoint(t.Position)
            if on then
                local center = camera.ViewportSize / 2
                local mouseX = sPos.X - center.X
                local mouseY = sPos.Y - center.Y
                
                -- Envío seguro para Xeno evitando crasheos usando delta delta
                if mousemoverel then
                    pcall(function()
                        mousemoverel(mouseX * Smoothness, mouseY * Smoothness)
                    end)
                else
                    -- Fallback súper firme de respaldo
                    local targetCFrame = CFrame.lookAt(camera.CFrame.Position, t.Position)
                    camera.CFrame = camera.CFrame:Lerp(targetCFrame, 0.25)
                end
            end
        end
    end
    
    -- ESP de Líneas
    if lEn then
        local currentFrames = visualFolder:GetChildren()
        local frameIndex = 1
        local centerBottom = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
        
        for _, o in ipairs(Players:GetPlayers()) do
            if o ~= localPlayer and o.Character then
                local hrp = o.Character:FindFirstChild("HumanoidRootPart")
                local hum = o.Character:FindFirstChildOfClass("Humanoid")
                
                if hrp and hum and hum.Health > 0 then
                    local sPos, on = camera:WorldToViewportPoint(hrp.Position)
                    if on then
                        local targetPos = Vector2.new(sPos.X, sPos.Y)
                        local distance = (targetPos - centerBottom).Magnitude
                        
                        local lineFrame = currentFrames[frameIndex]
                        if not lineFrame then
                            lineFrame = Instance.new("Frame", visualFolder)
                            lineFrame.BorderSizePixel = 0
                            lineFrame.BackgroundColor3 = Color3.fromRGB(40, 220, 255)
                        end
                        
                        lineFrame.Size = UDim2.fromOffset(distance, 1.5)
                        lineFrame.Position = UDim2.fromOffset((centerBottom.X + targetPos.X) / 2 - distance / 2, (centerBottom.Y + targetPos.Y) / 2)
                        lineFrame.Rotation = math.deg(math.atan2(targetPos.Y - centerBottom.Y, targetPos.X - centerBottom.X))
                        lineFrame.Visible = true
                        
                        frameIndex = frameIndex + 1
                    end
                end
            end
        end
        
        for i = frameIndex, #currentFrames do
            currentFrames[i].Visible = false
        end
    else
        visualFolder:ClearAllChildren()
    end
end)
