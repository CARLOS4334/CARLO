end)

-- ARRASTRE
local function drag(o, area)
    local d, start, sPos
    area.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType.Touch then d, start, sPos = true, i.Position, o.Position end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType.Touch then d = false end end)
    UserInputService.InputChanged:Connect(function(i) if d and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType.Touch) then local del = i.Position - start o.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + del.X, sPos.Y.Scale, sPos.Y.Offset + del.Y) end end)
end
drag(main, head) drag(bub, bub)

